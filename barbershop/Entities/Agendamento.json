{
  "name": "Agendamento",
  "type": "object",
  "properties": {
    "cliente_email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "barbeiro_id": {
      "type": "string",
      "description": "ID do barbeiro"
    },
    "barbeiro_nome": {
      "type": "string",
      "description": "Nome do barbeiro"
    },
    "servico_id": {
      "type": "string",
      "description": "ID do serviço"
    },
    "servico_nome": {
      "type": "string",
      "description": "Nome do serviço"
    },
    "servico_preco": {
      "type": "number",
      "description": "Preço do serviço"
    },
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do agendamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "agendado",
        "concluido",
        "cancelado"
      ],
      "default": "agendado"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações do cliente"
    },
    "cortesia": {
      "type": "boolean",
      "default": false,
      "description": "Se é um corte grátis de fidelidade"
    }
  },
  "required": [
    "cliente_email",
    "barbeiro_id",
    "servico_id",
    "data_hora"
  ]
}