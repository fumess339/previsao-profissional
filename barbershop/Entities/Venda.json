{
  "name": "Venda",
  "type": "object",
  "properties": {
    "cliente_email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string"
          },
          "produto_nome": {
            "type": "string"
          },
          "quantidade": {
            "type": "number"
          },
          "preco_unitario": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "description": "Total da venda"
    },
    "metodo_pagamento": {
      "type": "string",
      "enum": [
        "dinheiro",
        "cartao",
        "pix"
      ],
      "description": "Método de pagamento"
    }
  },
  "required": [
    "itens",
    "total"
  ]
}